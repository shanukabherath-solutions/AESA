# Copy to .env and fill in. NEVER commit .env.

# ---- Required ----
# >= 32 random chars:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# sqlite for local dev, or e.g. postgresql+psycopg://user:pass@host/db
# (The SQLite file keeps its original name, secureai.db, on purpose: renaming it would orphan existing data.)
DATABASE_URL=sqlite:////data/secureai.db
# ABSOLUTE host path where sandbox workspaces live.
#   Linux/macOS: /home/me/AESA/.workspaces
#   Windows (Docker Desktop): E:/AESA/.workspaces   (forward slashes)
WORKSPACE_HOST_DIR=
# Docker volume holding the database and registered repositories. Fresh installs: leave the default.
# If you ran this project BEFORE the rename (as SecureAI-Agent) and want to keep that data, use the old volume instead:
#   BACKEND_DATA_VOLUME=secureai-agent_backend-data     (confirm the exact name with: docker volume ls)
BACKEND_DATA_VOLUME=aesa_backend-data

# ---- AI provider ----
# scripted = offline rule-based demo provider (no key needed) | openai | gemini
AI_PROVIDER=scripted
AI_API_KEY=
# blank = provider default; set for any OpenAI-compatible server (vLLM, Ollama, gateways)
AI_BASE_URL=
AI_MODEL=

# ---- GitHub (optional; blank = local git + local CI flow) ----
# fine-grained token or GitHub App installation token with least privilege
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
# dry-run | github-workflow
DEPLOY_TARGET=dry-run

# ---- Demo seeding (development only) ----
SEED_DEMO=true
# >= 12 chars; used for the admin/developer/approver/viewer demo accounts
DEMO_PASSWORD=

# ---- Sandbox resources ----
# Default /tmp tmpfs and memory for every sandboxed command
SANDBOX_TMPFS_SIZE=256m
SANDBOX_MEMORY=1g
# Trivy copies its baked vulnerability DB into /tmp (the image root is read-only), and tmpfs counts against memory.
# Only trivy_fs gets these larger limits. TRIVY_TMPFS_MB (image build arg) must be >= DB size + ~128 MB.
SANDBOX_TRIVY_TMPFS=1200m
SANDBOX_TRIVY_MEMORY=2g
TRIVY_TMPFS_MB=1200

# ---- Policy knobs ----
# critical | high | medium
SECURITY_BLOCK_SEVERITY=high
ALLOW_SELF_APPROVAL=false
REQUIRE_DISTINCT_DEPLOY_APPROVER=false
PROTECTED_BRANCHES=main,master,production,release/*
